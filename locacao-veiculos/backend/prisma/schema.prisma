generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusVeiculo {
  DISPONIVEL
  ALUGADO
}

enum StatusLocacao {
  ATIVA
  FINALIZADA
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(120)
  email     String    @unique @db.VarChar(150)
  senha     String    @db.VarChar(100)
  criadoEm  DateTime  @default(now())
  locacoes  Locacao[]

  @@map("usuarios")
}

model Veiculo {
  id          Int           @id @default(autoincrement())
  marca       String        @db.VarChar(60)
  modelo      String        @db.VarChar(80)
  ano         Int
  placa       String        @unique @db.VarChar(10)
  cor         String        @db.VarChar(30)
  valorDiaria Decimal       @db.Decimal(10, 2)
  status      StatusVeiculo @default(DISPONIVEL)
  criadoEm    DateTime      @default(now())
  locacoes    Locacao[]

  @@map("veiculos")
}

model Locacao {
  id                     Int           @id @default(autoincrement())
  usuarioId              Int
  veiculoId              Int
  dataRetirada           DateTime      @default(now())
  dataPrevistaDevolucao  DateTime
  dataDevolucao          DateTime?
  valorDiaria            Decimal       @db.Decimal(10, 2)
  valorTotal             Decimal?      @db.Decimal(10, 2)
  status                 StatusLocacao @default(ATIVA)
  usuario                Usuario       @relation(fields: [usuarioId], references: [id])
  veiculo                Veiculo       @relation(fields: [veiculoId], references: [id])

  @@index([usuarioId])
  @@index([veiculoId])
  @@map("locacoes")
}
